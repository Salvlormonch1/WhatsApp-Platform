# =============================================================================
# SaaS Platform — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/saasplatform
DATABASE_USERNAME=saasplatform
DATABASE_PASSWORD=changeme_strong_password

# -----------------------------------------------------------------------------
# JWT / SECURITY
# -----------------------------------------------------------------------------
JWT_SECRET=changeme_at_least_32_chars_random_secret_here
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Encryption key for sensitive fields (WhatsApp tokens, etc.)
# Must be 32 bytes hex (64 hex chars)
ENCRYPTION_KEY=changeme_32bytes_hex_key_here_000000000000000000000000000000

# -----------------------------------------------------------------------------
# WHATSAPP — META CLOUD API
# -----------------------------------------------------------------------------
# 1. Crea una app en https://developers.facebook.com → tipo "Empresa"
# 2. Agrega el producto "WhatsApp" a tu app
# 3. En "API Setup" copia el Phone Number ID y genera un Access Token
# 4. En "Configuración → Básica" copia el App Secret
# 5. Configura el webhook: https://tu-dominio.com/api/v1/whatsapp/webhook

# Token que TÚ inventas — debe coincidir con lo que configuras en Meta
WHATSAPP_VERIFY_TOKEN=changeme_webhook_verify_token

# Secreto de tu Meta App — para validar firmas HMAC-SHA256 del webhook
WHATSAPP_APP_SECRET=changeme_app_secret

# Nota: el Phone Number ID y Access Token de cada negocio se configuran
# desde el dashboard: Configuración → WhatsApp (se guardan cifrados en BD)

# -----------------------------------------------------------------------------
# AI / LLM PROVIDER
# -----------------------------------------------------------------------------
# Choose your AI provider: openai | gemini | groq
# All support tool calling (function calling) required for bookings
AI_PROVIDER=openai

# --- OpenAI (default) ---
# Get key: https://platform.openai.com/api-keys
# Pricing: ~$0.01-0.05 USD per conversation (gpt-4o-mini)
OPENAI_API_KEY=changeme_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
# Options: gpt-4o | gpt-4o-mini | gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.3

# --- Google Gemini (free tier available!) ---
# Get key FREE: https://aistudio.google.com/apikey
# Pricing: FREE for Gemini 1.5 Flash (generous limits) | ~$0.002/1K tokens for Pro
# To use: set AI_PROVIDER=gemini
GEMINI_API_KEY=AIza...
# Options: gemini-2.0-flash | gemini-1.5-pro | gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# --- Groq (fastest, very cheap) ---
# Get key: https://console.groq.com/keys
# To use: set AI_PROVIDER=groq and set OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Models: llama-3.3-70b-versatile | mixtral-8x7b-32768

# -----------------------------------------------------------------------------
# EMAIL
# -----------------------------------------------------------------------------
# SMTP (compatible with SendGrid, Mailgun, Gmail, Resend, etc.)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=changeme_smtp_password
SMTP_FROM_ADDRESS=noreply@yourplatform.com
SMTP_FROM_NAME=Platform Name

# -----------------------------------------------------------------------------
# BACKEND
# -----------------------------------------------------------------------------
BACKEND_PORT=8080
# CORS: comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# FRONTEND
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# REPORTS SCHEDULER
# -----------------------------------------------------------------------------
# Cron expression: every Monday at 8:00 AM UTC
WEEKLY_REPORT_CRON=0 0 8 * * MON

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
# dev | prod
APP_ENV=dev
APP_VERSION=1.0.0
